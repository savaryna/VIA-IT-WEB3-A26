NODE_ENV=development
PORT=3000
# Comma-separated browser origins allowed for auth, HTTP, and WebSockets.
CLIENT_ORIGINS=http://localhost:5173
DATABASE_PATH=data/uno.sqlite

# BetterAuth configuration
# Required in every environment, at least 32 characters.
# Generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
