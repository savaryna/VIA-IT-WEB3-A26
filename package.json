{
  "name": "uno",
  "version": "0.0.1",
  "private": true,
  "description": "UNO",
  "keywords": [
    "functional",
    "oo",
    "uno"
  ],
  "license": "ISC",
  "author": "Ole Ildsgaard Hougaard",
  "contributors": [
    "Alexandru Tofan"
  ],
  "type": "module",
  "scripts": {
    "dev:server": "pnpm --filter @uno/server dev",
    "dev:client": "pnpm --filter @uno/vue dev",
    "test": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "pnpm codegen && tsc --noEmit && pnpm -r --if-present run check",
    "build": "pnpm codegen && pnpm -r --if-present run build",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "pnpm codegen --watch"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typed-document-node": "^7.2.0",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-operations": "^6.1.10",
    "@graphql-codegen/typescript-resolvers": "^6.1.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.22.0"
}
